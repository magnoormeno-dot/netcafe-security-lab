<?xml version="1.0" encoding="UTF-8"?>
<!--
  CafeSec WEF subscription: source-initiated (SourceInitiated).
  Once the collector imports this subscription, any client whose SubscriptionManager points to this collector will push the events below.
  Purely defensive: collects only security-relevant events for centralized analysis.
  Collection scope (extend as needed):
    - Security log: logon (4624/4625), privileges (4672), process creation (4688), account management, etc.
    - Sysmon Operational: all (process/network/file/registry/pipe/WMI, etc.)
    - PowerShell Operational: script block logging (4104)
    - System / Application: critical items such as service installation, crashes, etc.
  Import: wecutil cs cafesec-subscription.xml
-->
<Subscription xmlns="http://schemas.microsoft.com/2006/03/windows/events/subscription">
  <SubscriptionId>CafeSec-Security</SubscriptionId>
  <SubscriptionType>SourceInitiated</SubscriptionType>
  <Description>CafeSec Lab centralized security event forwarding (defensive use)</Description>
  <Enabled>true</Enabled>
  <Uri>http://schemas.microsoft.com/wbem/wsman/1/windows/EventLog</Uri>
  <ConfigurationMode>Custom</ConfigurationMode>

  <Delivery Mode="Push">
    <Batching>
      <MaxItems>50</MaxItems>
      <MaxLatencyTime>30000</MaxLatencyTime>
    </Batching>
    <PushSettings>
      <Heartbeat Interval="60000"/>
    </PushSettings>
  </Delivery>

  <Query>
    <![CDATA[
      <QueryList>
        <Query Id="0">
          <Select Path="Security">*[System[(EventID=4624 or EventID=4625 or EventID=4634 or EventID=4647 or EventID=4672 or EventID=4688 or EventID=4720 or EventID=4724 or EventID=4728 or EventID=4732 or EventID=4756)]]</Select>
          <Select Path="Microsoft-Windows-Sysmon/Operational">*</Select>
          <Select Path="Microsoft-Windows-PowerShell/Operational">*[System[(EventID=4104)]]</Select>
          <Select Path="System">*[System[(EventID=7045 or EventID=7040)]]</Select>
          <Select Path="Application">*[System[(Level=1 or Level=2)]]</Select>
        </Query>
      </QueryList>
    ]]>
  </Query>

  <ReadExistingEvents>false</ReadExistingEvents>
  <TransportName>HTTP</TransportName>
  <ContentFormat>RenderedText</ContentFormat>
  <Locale Language="en-US"/>
  <LogFile>ForwardedEvents</LogFile>
  <!-- Domain mode (cafesec.lab): use only AllowedSourceDomainComputers; source-initiated uses Kerberos, so no certificate is required.
       The SDDL grants access to Domain Computers (DC) and Network Service (NS) — the standard defaults within a domain.
       (The workgroup-only AllowedSourceNonDomainComputers / certificate issuer list has been removed: in a domain it would only
        fail authorization and contradict itself semantically.) -->
  <AllowedSourceDomainComputers>O:NSG:NSD:(A;;GA;;;DC)(A;;GA;;;NS)</AllowedSourceDomainComputers>
</Subscription>
